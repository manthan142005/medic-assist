# MediAssist Backend Environment Configuration Example
# Copy this file to .env or configure your system environment variables accordingly.

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/mediassist_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
